{
  "name": "lpgenet",
  "version": "2.0.0",
  "private": true,
  "description": "Premium Landing Page Generator with 20+ Categories, 100+ Templates, 20+ Themes",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^1.10.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.0.0",
  "keywords": [
    "landing-page",
    "generator",
    "template",
    "no-code",
    "builder",
    "real-estate",
    "ecommerce",
    "saas",
    "healthcare",
    "education"
  ],
  "author": "Landing Page Generator Team",
  "license": "MIT"
}